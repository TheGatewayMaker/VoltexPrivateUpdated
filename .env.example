ENABLE_POSTGRES_STORAGE=true
DATABASE_URL=postgresql://voltex_app:CHANGE_ME_LOCAL_ONLY_URLENCODED@127.0.0.1:5432/voltex_sms
LOCAL_STORAGE_DIR=server/data
ENABLE_R2_BACKUP=false
PUBLIC_APP_ORIGIN=https://voltexchat.online
ALLOWED_ORIGINS=https://voltexchat.online,https://www.voltexchat.online,https://voltex.g2k.site,http://127.0.0.1:8080,http://localhost:8080
ENABLE_MESSAGE_ARCHIVAL=false
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_AVATAR_BUCKET_NAME=
SNAPSHOT_INTERVAL_MS=3600000
SNAPSHOT_RETENTION_COUNT=24
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@voltexchat.online
KLIPY_API_KEY=
KLIPY_LOCALE=us_US
KLIPY_RATING=pg
VOLTEX_MEDIA_STORAGE_ROOT=/var/lib/voltex/media
ADMIN_PANEL_EMAIL=
ADMIN_PANEL_USERNAME=
# Required for admin panel auth. Strongly recommended:
# set ADMIN_PANEL_PASSWORD_HASH and a long random ADMIN_PANEL_PASSWORD_PEPPER.
# Hash format: sha256("${ADMIN_PANEL_PASSWORD_PEPPER}:${password}")
ADMIN_PANEL_PASSWORD_HASH=
ADMIN_PANEL_PASSWORD_PEPPER=
# Plaintext password is for local development only (avoid in production):
# ADMIN_PANEL_PASSWORD=
# For multiple admin accounts, create:
# server/data/voltex-system/admin-panel/credentials.json
# with either a single object, an array of objects, or:
# { "admins": [{ "email": "...", "username": "...", "passwordHash": "...", "passwordPepper": "..." }] }

ARCHIVAL_INTERVAL_MS=7200000
MESSAGE_AGE_MS=7200000
ARCHIVAL_BATCH_SIZE=1000
DELETE_AFTER_ARCHIVAL=true
DELETE_GRACE_MS=0
